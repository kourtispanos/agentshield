# Neon layout for the AgentShield desktop app: a dark blue->magenta gradient
# background, a live heartbeat line under the title, a chat column on the left
# and a live firewall panel on the right, an input row at the bottom.

<RoundedButton@Button>:
    bg_color: 0.2, 0.45, 0.85, 1
    glow: 0.4, 0.6, 1, 1
    background_color: 0, 0, 0, 0
    background_normal: ''
    background_down: ''
    color: 1, 1, 1, 1
    bold: True
    disabled_color: 0.6, 0.6, 0.6, 1
    canvas.before:
        Color:
            rgba: self.bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [14]
        Color:
            rgba: self.glow if not self.disabled else (0.3, 0.3, 0.3, 0.4)
        Line:
            width: 1.3
            rounded_rectangle: (self.x, self.y, self.width, self.height, 14)

<NeonCard@BoxLayout>:
    border_color: 0.35, 0.5, 1, 0.55
    canvas.before:
        Color:
            rgba: 0.07, 0.08, 0.14, 0.82
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [16]
        Color:
            rgba: self.border_color
        Line:
            width: 1.2
            rounded_rectangle: (self.x, self.y, self.width, self.height, 16)

<ShieldLayout>:
    orientation: 'vertical'
    padding: 18
    spacing: 12
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size
            texture: self.bg_texture

    # ---------- Header ----------
    BoxLayout:
        size_hint_y: 0.09
        spacing: 10
        Image:
            id: header_icon
            size_hint_x: None
            width: 40
            fit_mode: "contain"
        Label:
            text: "AgentShield"
            font_size: 26
            bold: True
            color: 0.92, 0.94, 1, 1
            halign: 'left'
            valign: 'middle'
            text_size: self.size
        Label:
            id: status_label
            text: "Ready"
            font_size: 15
            color: 0.6, 0.66, 0.8, 1
            halign: 'right'
            valign: 'middle'
            text_size: self.size
        Label:
            id: level_label
            text: "Threat Lv 1"
            markup: True
            size_hint_x: None
            width: 120
            font_size: 14
            bold: True
            halign: 'right'
            valign: 'middle'
            text_size: self.size
        Spinner:
            id: model_spinner
            text: "qwen2.5:7b"
            values: ["qwen2.5:7b", "llama3.2:latest"]
            size_hint_x: None
            width: 170
            font_size: 13
            background_normal: ''
            background_color: 0.14, 0.16, 0.24, 1
            color: 0.85, 0.9, 1, 1
        Label:
            text: "● Protected: ON"
            size_hint_x: None
            width: 180
            font_size: 15
            bold: True
            color: 0.4, 0.95, 0.65, 1
            halign: 'right'
            valign: 'middle'
            text_size: self.size

    # ---------- Live heartbeat ----------
    PulseWidget:
        id: pulse
        size_hint_y: 0.11

    # ---------- Body: chat | firewall ----------
    BoxLayout:
        size_hint_y: 0.68
        spacing: 14

        NeonCard:
            orientation: 'vertical'
            size_hint_x: 0.62
            border_color: 0.35, 0.5, 1, 0.55
            padding: 12
            Label:
                text: "Chat with the model"
                size_hint_y: None
                height: 26
                font_size: 14
                bold: True
                color: 0.6, 0.72, 1, 1
                halign: 'left'
                valign: 'middle'
                text_size: self.size
            ScrollView:
                id: chat_scroll
                bar_width: 4
                Label:
                    id: chat_label
                    text: ""
                    markup: True
                    font_size: 15
                    color: 0.9, 0.92, 0.97, 1
                    size_hint_y: None
                    height: self.texture_size[1]
                    text_size: self.width, None
                    halign: 'left'
                    valign: 'top'
                    padding: 8, 8

        NeonCard:
            orientation: 'vertical'
            size_hint_x: 0.38
            border_color: 1, 0.3, 0.6, 0.5
            padding: 12
            Label:
                text: "Firewall — live"
                size_hint_y: None
                height: 26
                font_size: 14
                bold: True
                color: 1, 0.55, 0.8, 1
                halign: 'left'
                valign: 'middle'
                text_size: self.size
            ScrollView:
                id: fw_scroll
                bar_width: 4
                Label:
                    id: fw_label
                    text: ""
                    markup: True
                    font_size: 13
                    color: 0.82, 0.85, 0.92, 1
                    size_hint_y: None
                    height: self.texture_size[1]
                    text_size: self.width, None
                    halign: 'left'
                    valign: 'top'
                    padding: 8, 8

    # ---------- Input row ----------
    BoxLayout:
        size_hint_y: 0.12
        spacing: 10
        TextInput:
            id: input
            hint_text: "Type a message or a task..."
            font_size: 15
            multiline: False
            background_color: 0.1, 0.12, 0.2, 1
            foreground_color: 0.92, 0.94, 0.98, 1
            hint_text_color: 0.5, 0.55, 0.68, 1
            cursor_color: 0.5, 0.75, 1, 1
            padding: 14, 14
        RoundedButton:
            id: send_btn
            text: "Send"
            size_hint_x: None
            width: 130
            bg_color: 0.18, 0.42, 0.9, 1
            glow: 0.4, 0.65, 1, 1
